# Normalize line endings and force text handling so files like README.md
# are never mis-detected as binary (which breaks GitHub's markdown render).
* text=auto eol=lf

*.md   text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.csv  text eol=lf
*.env  text eol=lf
