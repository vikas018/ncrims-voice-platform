# Base URL for API calls. In dev, Vite proxies /api to the backend (see vite.config.js),
# so the default empty value works. Set this only for production deploys.
VITE_API_BASE=

# Vapi Web SDK public key — used by the in-browser "Test Call" button (Phase 3 demo).
# Leave blank to run the button in simulated mode.
VITE_VAPI_PUBLIC_KEY=
VITE_VAPI_ASSISTANT_ID=
