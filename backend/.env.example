# ---- Server ----
PORT=5000
NODE_ENV=development
# Comma-separated origins allowed by CORS (the frontend dev server)
CORS_ORIGIN=http://localhost:5173

# ---- Database ----
# MongoDB Atlas free-tier (M0) connection string, or local mongodb://127.0.0.1:27017/ncrims
MONGO_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/ncrims?retryWrites=true&w=majority

# ---- Auth ----
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Billing (pulse rule) ----
# Minimum billable seconds for a connected call (60-second pulse).
BILLING_MIN_PULSE_SECONDS=60
# Overage mode after the first minute: "whole_minute" (ceil) or "per_second".
# VOICEARTAI proposal = 1-min minimum then actual duration -> per_second.
BILLING_OVERAGE_MODE=per_second
# GST added on top of package amounts (percent).
BILLING_GST_PERCENT=18

# ---- Voice provider (the adapter switch) ----
# Global default. One of: vapi | retell | bolna | sarvam | plivo
VOICE_PROVIDER=vapi

# ---- Two-engine routing (Phase 4) ----
# Which provider dials each campaign engine. Leave blank to use VOICE_PROVIDER
# (keeps the demo on vapi). In production:
#   ANNOUNCEMENT_PROVIDER=plivo   (cheap one-way confirmations, ~Rs0.70/min)
#   CONVERSATION_PROVIDER=sarvam  (full interactive AI, ~Rs3.9/min)
ANNOUNCEMENT_PROVIDER=
CONVERSATION_PROVIDER=

# Plivo (announcement engine) — Phase 4
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM_NUMBER=
PLIVO_ANSWER_URL=
PLIVO_WEBHOOK_SECRET=

# Vapi (Demo / MVP)
VAPI_API_KEY=your-vapi-private-key
VAPI_ASSISTANT_ID=your-vapi-assistant-id
VAPI_PHONE_NUMBER_ID=your-vapi-phone-number-id
VAPI_WEBHOOK_SECRET=any-shared-secret-for-signature-check

# Bolna (Production) — placeholders, wired in Phase 4
BOLNA_API_KEY=
BOLNA_AGENT_ID=
BOLNA_WEBHOOK_SECRET=

# Sarvam (Production) — placeholders, wired in Phase 4
SARVAM_API_KEY=
SARVAM_AGENT_ID=
SARVAM_WEBHOOK_SECRET=

# ---- Voice test feature (Gemini) at /voice-test ----
# Turn the endpoint on. Must be "true" or POST /api/claude-voice/chat returns 404.
ENABLE_CLAUDE_VOICE=false
# Google Gemini API key (free tier, from aistudio.google.com/apikey).
# Used server-side only, NEVER sent to the browser.
GEMINI_API_KEY=
# Optional: override the model. Leave BLANK to use the default
# (gemini-flash-latest — an alias that never goes stale). Do not pin a dated
# model name here; retired versions return a 404.
GEMINI_MODEL=
